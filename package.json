  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,VITE\" -c \"blue.bold,green.bold\" \"npm run dev:server\" \"npm run dev:client\"",
